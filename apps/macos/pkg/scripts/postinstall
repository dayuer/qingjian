#!/bin/sh
# 装完之后：杀掉旧进程，再以当前登录用户的身份把输入源注册并启用。
# 安装器以 root 运行，而输入源是每个用户自己的设置，所以要切到用户的会话里去调 `qingjian-macos --register`。
set -u
APP="/Library/Input Methods/Qingjian.app"
BIN="$APP/Contents/MacOS/qingjian-macos"

pkill -x qingjian-macos 2>/dev/null || true

user="$(stat -f%Su /dev/console 2>/dev/null || true)"
if [ -n "$user" ] && [ "$user" != "root" ]; then
    uid="$(id -u "$user")"
    if launchctl asuser "$uid" sudo -u "$user" "$BIN" --register; then
        echo "素笺：已为 $user 注册并启用输入源"
    else
        echo "素笺：自动注册输入源失败，请在「系统设置 → 键盘 → 输入法 → 编辑… → +」的「简体中文」下添加「素笺」；列表里没有就注销后重新登录"
    fi
    # 分叉补丁：素笺云已链进输入法进程，清掉以前单独装的常驻程序（配置与同步进度留着，接着用）
    launchctl bootout "gui/$uid/app.qingjian.cloud.agent" 2>/dev/null || true
    home="$(dscl . -read "/Users/$user" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"
    if [ -n "$home" ]; then
        rm -f "$home/Library/LaunchAgents/app.qingjian.cloud.agent.plist"
        rm -rf "$home/Applications/QingjianCloud.app"
        rm -rf "$home/Library/Application Support/QingjianCloud/menu.txt" "$home/Library/Application Support/QingjianCloud/commands"
    fi
else
    echo "素笺：没找到登录用户，跳过自动注册"
fi
exit 0
