 use std::collections::HashMap;
 
//! D3 原型（不进仓库）：选几次排第一、残段英文不学。

use std::collections::HashMap;
use std::sync::{Arc, Mutex};

use super::*;

/// 静态首选故意给错：式 词频压过 是，地 压过 的（模拟上游旧数据里 #425 / #475 的局面）。
const D3: &str = "式\tshi\t90000\n是\tshi\t50000\n十\tshi\t30000\n地\tdi\t90000\n的\tde\t50000\n都\tdou\t30000\n我\two\t90000\n来\tlai\t50000\n我啦\two la\t3000\n我来\two lai\t2000\n";

struct Spy {
    inner: CountingLearner,
    english: Arc<Mutex<Vec<String>>>,
}

impl Learner for Spy {
    fn record(&mut self, c: &Candidate) { self.inner.record(c) }
    fn weight(&self, t: &str) -> u32 { self.inner.weight(t) }
    fn record_choice(&mut self, i: &str, t: &str) { self.inner.record_choice(i, t) }
    fn choice_weight(&self, i: &str, t: &str) -> u32 { self.inner.choice_weight(i, t) }
    fn learn_english(&mut self, w: &str) { self.english.lock().unwrap().push(w.to_owned()) }
}

fn spy_engine() -> (Engine, Arc<Mutex<Vec<String>>>) {
    let english = Arc::new(Mutex::new(Vec::new()));
    let engine = Engine::new(Dictionary::parse(D3).unwrap())
        .with_english(WordList::parse("I\ti\t6000\nIA\tia\t3000\n").unwrap())
        .with_learner(Box::new(Spy { inner: CountingLearner(HashMap::new()), english: english.clone() }));
    (engine, english)
}

fn picks_until_first(engine: &mut Engine, input: &str, target: &str, max: usize) -> Vec<usize> {
    let mut ranks = Vec::new();
    for _ in 0..=max {
        engine.set_input(input);
        let items = engine.query().unwrap().candidates.items;
        let rank = items.iter().position(|c| c.text == target).map_or(0, |p| p + 1);
        ranks.push(rank);
        if rank == 1 || rank == 0 { break; }
        let c = items[rank - 1].clone();
        engine.commit(&c);
        engine.clear();
    }
    ranks
}

#[test]
fn d3_how_many_picks_until_first() {
    let (mut engine, _) = spy_engine();
    let shi = picks_until_first(&mut engine, "shi", "是", 10);
    let d = picks_until_first(&mut engine, "d", "的", 10);
    eprintln!("D3 shi→是 名次序列 {shi:?}；d→的 名次序列 {d:?}");
    // 反向：选过 是 一次后再选 式 几次回到第一
    let back = picks_until_first(&mut engine, "shi", "式", 10);
    eprintln!("D3 回选 式 名次序列 {back:?}");
}

#[test]
fn d3_remainder_english_is_not_learned() {
    let (mut engine, english) = spy_engine();
    engine.set_input("wolai");
    let items = engine.query().unwrap().candidates.items;
    let wola = items.iter().find(|c| c.text == "我啦").cloned().unwrap();
    engine.commit(&wola);
    eprintln!("D3 剩余 {:?}", engine.composition().scope());
    let items = engine.query().unwrap().candidates.items;
    eprintln!("D3 残段候选 {:?}", items.iter().map(|c| (&c.text, c.kind)).collect::<Vec<_>>());
    if let Some(i) = items.iter().find(|c| c.kind == CandidateKind::English).cloned() {
        engine.commit(&i);
    }
    eprintln!("D3 学到的英文 {:?}", english.lock().unwrap());
    assert!(english.lock().unwrap().is_empty());
    engine.set_input("i");
    let i = engine.query().unwrap().candidates.items[0].clone();
    engine.commit(&i);
    assert_eq!(*english.lock().unwrap(), vec!["I".to_owned()]);
}
