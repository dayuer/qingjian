# 复制成 .env 后修改。域名要先解析到这台 VPS，并放行 80 / 443 端口。
QINGJIAN_DOMAIN=cloud.example.com

# 剪贴板保留：最多多少条、最多多少天。
QINGJIAN_CLOUD_CLIP_KEEP=200
QINGJIAN_CLOUD_CLIP_DAYS=30

# 大模型代理：输入法的云联想经服务器转发，密钥只放在这里。不填 QINGJIAN_LLM_API_KEY 就不提供代理。
QINGJIAN_LLM_BASE_URL=https://api.deepseek.com
QINGJIAN_LLM_API_KEY=
# 覆盖输入法请求里的模型名（可不填）
QINGJIAN_LLM_MODEL=
# 往请求里插多少字「各设备最近输入的文字」当上文；0 为不插（缺省，效果评测过再开）
QINGJIAN_LLM_CONTEXT_CHARS=0
